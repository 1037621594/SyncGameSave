<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application android:name=".SyncApplication"
        android:allowBackup="false"
        android:usesCleartextTraffic="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@drawable/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.SyncGameSave">
        <activity android:name=".ui.MappingEditorActivity" android:exported="false" />
        <activity android:name=".ui.S3ConfigActivity" android:exported="false" />
        <activity android:name=".ui.S3BrowserActivity" android:exported="false" />
        <activity android:name=".ui.SettingsActivity" android:exported="false" />
        <activity android:name=".ui.PokemonAliasActivity" android:exported="false" />
        <activity android:name=".pokemon.PokemonLaunchActivity" android:exported="false"
            android:theme="@style/Theme.SyncGameSave.Transparent"
            android:configChanges="orientation|screenSize|keyboardHidden" />
        <service android:name=".pokemon.PokemonOverlayService" android:exported="false"
            android:foregroundServiceType="mediaProjection" />
        <service android:name=".pokemon.PokemonAccessibilityService" android:exported="true"
            android:label="游戏工具"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data android:name="android.accessibilityservice"
                android:resource="@xml/pokemon_accessibility_config" />
        </service>
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
